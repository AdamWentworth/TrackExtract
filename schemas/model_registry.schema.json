{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trackextract.local/schema/model_registry.schema.json",
  "title": "Track Extract Model Registry",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "displayName",
      "backend",
      "tasks",
      "stems",
      "sampleRate",
      "quality",
      "version",
      "installed",
      "path"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "displayName": { "type": "string", "minLength": 1 },
      "backend": {
        "type": "string",
        "enum": ["stub", "onnx", "pytorch-worker", "external-process", "python-engine"]
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "vocals_instrumental",
            "full_stem_split",
            "drums_only",
            "bass_only",
            "guitar_only",
            "piano_only",
            "experimental_best_quality",
            "vocal_cleanup_chain",
            "layered_vocal_cleanup",
            "vocal_dereverb",
            "vocal_denoise"
          ]
        },
        "minItems": 1
      },
      "stems": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "sampleRate": { "type": "integer", "minimum": 8000 },
      "quality": { "type": "string", "minLength": 1 },
      "version": { "type": "string", "minLength": 1 },
      "installed": { "type": "boolean" },
      "path": { "type": "string" },
      "downloadUrl": { "type": "string" },
      "sourceUrl": { "type": "string" },
      "license": { "type": "string" },
      "notes": { "type": "string" },
      "downloadSizeMb": { "type": "integer", "minimum": 1 },
      "installMethod": {
        "type": "string",
        "enum": ["direct-url", "audio-separator", "source-only"]
      },
      "runtime": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["demucs", "audio-separator", "stub", ""]
          },
          "modelFilename": { "type": "string" },
          "workerScript": { "type": "string" },
          "demucsModel": { "type": "string" },
          "demucsMode": { "type": "string" },
          "device": { "type": "string" }
        },
        "additionalProperties": true
      },
      "options": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "displayName", "type", "defaultValue"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "type": {
              "type": "string",
              "enum": ["select", "integer", "number", "boolean"]
            },
            "defaultValue": {},
            "description": { "type": "string" },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
