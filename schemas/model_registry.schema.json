{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phlosion.com/trackextract/model_registry.schema.json",
  "title": "TrackExtract Model Registry",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "displayName",
      "backend",
      "tasks",
      "stems",
      "sampleRate",
      "quality",
      "version",
      "installed",
      "path"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "displayName": { "type": "string", "minLength": 1 },
      "backend": {
        "type": "string",
        "enum": ["stub", "onnx", "pytorch-worker", "external-process"]
      },
      "tasks": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "vocals_instrumental",
            "full_stem_split",
            "drums_only",
            "bass_only",
            "guitar_only",
            "piano_only",
            "experimental_best_quality"
          ]
        },
        "minItems": 1
      },
      "stems": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1
      },
      "sampleRate": { "type": "integer", "minimum": 8000 },
      "quality": { "type": "string", "minLength": 1 },
      "version": { "type": "string", "minLength": 1 },
      "installed": { "type": "boolean" },
      "path": { "type": "string" },
      "downloadUrl": { "type": "string" },
      "runtime": {
        "type": "object",
        "properties": {
          "workerScript": { "type": "string" },
          "demucsModel": { "type": "string" },
          "demucsMode": { "type": "string" },
          "device": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
