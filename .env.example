# Optional: force TrackExtract to use a specific Python interpreter.
# TRACKEXTRACT_ENGINE_PYTHON=/absolute/path/to/python

# Optional: override the managed engine virtual environment path.
# TRACKEXTRACT_ENGINE_VENV=.venv-trackextract-engine

# audio-separator install extra: cpu, gpu, or dml.
TRACKEXTRACT_AUDIO_SEPARATOR_EXTRA=cpu

# Opt in to network URL checks during npm run test:all.
TRACKEXTRACT_TEST_NETWORK=0
