{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Track Extract",
  "version": "0.1.0",
  "identifier": "com.trackextract.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Track Extract",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' data: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../resources/models.json",
      "../resources/workflows.json",
      "../engine/src",
      "../schemas/model_registry.schema.json",
      "../schemas/workflows.schema.json",
      "../schemas/session.schema.json"
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
