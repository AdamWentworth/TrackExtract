{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrackExtract",
  "version": "0.1.0",
  "identifier": "com.phlosion.trackextract",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrackExtract",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$LOCALDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$AUDIO/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../resources/models.json",
      "../workers/demucs_worker.py",
      "../schemas/model_registry.schema.json",
      "../schemas/session.schema.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
